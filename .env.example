# ---- Public site ----
# Canonical URL used for metadata, sitemap and absolute links.
# Production defaults to https://megentllc.com when this is empty.
NEXT_PUBLIC_SITE_URL=https://megentllc.com
# Where the Dashaun Grey artist site lives (the roster links out to it).
NEXT_PUBLIC_DASHAUN_URL=https://dashaungrey.com

# ---- Database ----
# Postgres connection string. Vercel → Storage → Neon (or Supabase) injects
# DATABASE_URL / POSTGRES_URL automatically. Leave empty locally to use the
# JSON file store in ./data (dev only).
DATABASE_URL=

# ---- Admin / owner dashboard ----
# 32+ random chars. Signs the admin session cookie. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# First-run owner. If set, the owner account is created automatically the
# first time the admin is opened and no users exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Alternative to ADMIN_EMAIL/PASSWORD: a one-time token that unlocks
# /admin/setup in production so the first owner can be created in the browser.
ADMIN_SETUP_TOKEN=

# ---- Notifications (optional) ----
# Every inquiry / demo submission is POSTed here as JSON (Zapier, Make, Slack,
# a Telegram relay...). Leave empty to store only.
NOTIFY_WEBHOOK=
# Where "email us" style links point in the public site (footer, contact).
NEXT_PUBLIC_CONTACT_EMAIL=
