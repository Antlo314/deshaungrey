# ---- Public site ----
# Canonical URL used for metadata, sitemap and absolute links.
# Production defaults to https://megentllc.com when this is empty.
NEXT_PUBLIC_SITE_URL=https://megentllc.com
# The artist's own domain, IF one is ever registered. dashaungrey.com does not
# exist yet, so leave this empty — the roster then links to /artists/dashaun-grey
# instead of a dead host.
NEXT_PUBLIC_DASHAUN_URL=

# ---- Database ----
# Postgres connection string. Vercel → Storage → Neon (or Supabase) injects
# DATABASE_URL / POSTGRES_URL automatically. Leave empty locally to use the
# JSON file store in ./data (dev only).
DATABASE_URL=

# ---- Admin / owner dashboard ----
# 32+ random chars. Signs the admin session cookie. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# First-run owner. If set, the owner account is created automatically the
# first time the admin is opened and no users exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Alternative to ADMIN_EMAIL/PASSWORD: a one-time token that unlocks
# /admin/setup in production so the first owner can be created in the browser.
ADMIN_SETUP_TOKEN=

# ---- Notifications (optional) ----
# Every inquiry / demo submission is POSTed here as JSON (Zapier, Make, Slack,
# a Telegram relay...). Leave empty to store only.
NOTIFY_WEBHOOK=
# Where "email us" style links point in the public site (footer, contact).
NEXT_PUBLIC_CONTACT_EMAIL=services@megentllc.com

# ---- Local end-to-end smoke test (scripts/e2e-admin.mjs), optional ----
# Only used by the dev smoke test against a local server. Never set these to a
# real deployed owner's credentials.
E2E_OWNER_NAME=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
# Path to a package.json beside a node_modules containing playwright (dev only).
PLAYWRIGHT_ROOT=

# ---- ASH's voice (optional) ----
# With both of these set she SPEAKS her answers; without them she is text-only
# and everything else still works. The key is only ever used server-side.
# Budget: 7 spoken replies per visitor per day, 400 chars/request (lib/quota.ts).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Live two-way call. Needs a Conversational Agent created in the ElevenLabs
# dashboard using site/VOICE.md — the API key cannot create one. While this is
# empty the widget hides the "start a live call" button rather than offering a
# call that can only fail. Do NOT reuse the artist site's agent: it is configured
# with the artist persona and would introduce her as one artist's fan.
ELEVENLABS_AGENT_ID=

# ---- ASH's free-form intelligence (optional) ----
# Without it she still answers every common question from lib/ash-brain.ts rules.
# With it, Claude answers the rest using the generated fact sheet as its ONLY
# source of truth. Capped at 500 calls/day.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
